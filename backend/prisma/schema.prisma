generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(uuid())
  email         String   @unique
  passwordHash  String
  walletAddress String?  @unique
  roles         String[]
  requestedRole String?
  roleStatus    String   @default("PENDING")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions      Session[]
}

model Session {
  id               String   @id @default(uuid())
  userId           String
  refreshTokenHash String
  expiresAt        DateTime
  createdAt        DateTime @default(now())

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Asset {
  id             String   @id @default(uuid())
  factoryAssetId Int?
  tokenContract  String   @unique
  referenceId    String?
  name           String
  symbol         String
  description    String?
  issuerWallet   String?
  legalOwner     String?
  metadata       Json?
  deployedAt     DateTime?
  lifecycleState String   @default("ISSUED")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model AssetRequest {
  id              String   @id @default(uuid())
  status          String   @default("PENDING_REVIEW")
  issuerWallet    String   @map("issuer_wallet")
  legalOwner      String?  @map("legal_owner")
  referenceId     String?  @map("reference_id")
  name            String
  symbol          String
  description     String?
  assetType       String   @map("asset_type")
  currency        String   @default("USD")
  location        String?
  underlyingValue Float    @map("underlying_value")
  totalSupply     Int      @map("total_supply")
  decimals        Int      @default(6)
  initialPrice    Float    @map("initial_price")
  claimTopics     String[] @map("claim_topics")
  trustedIssuers  Json?    @map("trusted_issuers")
  complianceModules String[] @map("compliance_modules")
  documents       Json?
  metadata        Json?
  reviewedAt      DateTime? @map("reviewed_at")
  reviewedBy      String?   @map("reviewed_by")
  rejectionReason String?   @map("rejection_reason")
  deployedAssetId String?   @map("deployed_asset_id")
  txHash          String?   @map("tx_hash")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@index([issuerWallet])
  @@index([createdAt])
  @@map("asset_requests")
}

model TokenState {
  id           String   @id @default(uuid())
  tokenContract String @unique
  name         String
  symbol       String
  decimals     Int
  totalSupply  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model TokenAsset {
  id           String   @id @default(uuid())
  tokenContract String
  assetId      Int
  referenceId  String
  description  String
  legalOwner   String
  metadata     Json?
  totalTokenized String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tokenContract, assetId])
}

model TokenBalance {
  id            String   @id @default(uuid())
  tokenContract String
  walletAddress String
  balance       String
  updatedAt     DateTime @updatedAt

  @@unique([tokenContract, walletAddress])
}

model IssuanceRequest {
  id             String    @id @default(uuid())
  requestId      Int       // On-chain request ID
  tokenContract  String
  assetId        Int
  recipient      String
  amount         String
  requester      String
  status         String    @default("PENDING") // PENDING | APPROVED | REJECTED
  reason         String?
  txHash         String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  
  // Approval fields
  approvedAt     DateTime?
  approvedBy     String?
  
  // Rejection fields
  rejectedAt     DateTime?
  rejectedBy     String?
  rejectionReason String?
  
  @@unique([tokenContract, requestId])
  @@index([tokenContract])
  @@index([status])
  @@index([requester])
  @@index([recipient])
}

model RedemptionRequest {
  id              String    @id @default(uuid())
  requestId       Int       // On-chain request ID
  tokenContract   String
  assetId         Int
  requester       String
  amount          String
  reason          String?
  status          String    @default("PENDING") // PENDING | APPROVED | REJECTED
  txHash          String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  
  // Approval fields
  approvedAt      DateTime?
  approvedBy      String?
  
  // Rejection fields
  rejectedAt      DateTime?
  rejectedBy      String?
  rejectionReason String?
  
  @@unique([tokenContract, requestId])
  @@index([tokenContract])
  @@index([status])
  @@index([requester])
}

model ComplianceRule {
  id               String   @id @default(uuid())
  allowedCountries String[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model TransferLimit {
  id        String   @id @default(uuid())
  address   String   @unique
  limit     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TrackedWallet {
  id           String   @id @default(uuid())
  walletAddress String  @unique
  label        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model IndexerState {
  id        String   @id @default(uuid())
  status    String
  error     String?
  lastRunAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ActivityLog {
  id          String   @id @default(uuid())
  actionType  String
  actorUserId String?
  actorWallet String?
  entityType  String?
  entityId    String?
  assetId     String?
  oldValue    Json?
  newValue    Json?
  reason      String?
  txHash      String?
  createdAt   DateTime @default(now())
}

model IdentitySnapshot {
  id          String   @id @default(uuid())
  wallet      String
  claimTopics String[]
  verified    Boolean  @default(false)
  country     String?
  createdAt   DateTime @default(now())
}

model KycApplication {
  id                String   @id @default(uuid())
  walletAddress     String   @unique
  email             String?
  fullName          String
  dateOfBirth       String?
  nationality       String
  country           String
  addressLine1      String
  addressLine2      String?
  city              String
  state             String?
  postalCode        String
  phoneNumber       String?
  
  // Document references
  idDocumentUrl     String?
  proofOfAddressUrl String?
  selfieUrl         String?
  
  // Application status
  status            String   @default("PENDING") // PENDING | APPROVED | REJECTED | UNDER_REVIEW
  submittedAt       DateTime @default(now())
  reviewedAt        DateTime?
  reviewedBy        String?
  rejectionReason   String?
  
  // OnchainID tracking
  onchainIdAddress  String?
  onchainIdCreated  Boolean  @default(false)
  
  // Metadata
  notes             String?
  riskScore         Int?     // 0-100
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  
  @@index([walletAddress])
  @@index([status])
  @@index([submittedAt])
}

model KycDocument {
  id              String   @id @default(uuid())
  applicationId   String
  documentType    String   // ID_CARD | PASSPORT | DRIVERS_LICENSE | PROOF_OF_ADDRESS | SELFIE
  fileName        String
  fileUrl         String
  fileSize        Int
  mimeType        String
  uploadedAt      DateTime @default(now())
  verified        Boolean  @default(false)
  verifiedBy      String?
  verifiedAt      DateTime?
  
  @@index([applicationId])
}


model TokenPurchaseRequest {
  id                String   @id @default(uuid())
  assetId           String?  @map("asset_id")
  tokenContract     String
  investorWallet    String
  amount            Float?
  
  fullName          String?
  email             String?
  nationality       String?
  country           String?
  idDocumentUrl     String?
  proofOfAddressUrl String?
  
  kycProvider       String?
  amlProvider       String?
  issuerWallet      String?
  requiredClaimTopics String[] @default([]) @map("required_claim_topics")
  documents         Json?
  
  status            String   @default("SUBMITTED")
  
  kycApprovedAt     DateTime?
  kycApprovedBy     String?
  kycClaimTxHash    String?
  amlApprovedAt     DateTime?
  amlApprovedBy     String?
  amlClaimTxHash    String?
  issuerApprovedAt  DateTime?
  issuerApprovedBy  String?
  mintTxHash        String?
  mintedAt          DateTime?
  rejectionReason   String?
  rejectedAt        DateTime?
  rejectedBy        String?
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([assetId])
  @@index([tokenContract])
  @@index([investorWallet])
  @@index([kycProvider])
  @@index([amlProvider])
  @@index([issuerWallet])
}

model TokenTransferRequest {
  id                  String    @id
  assetId             String?   @map("asset_id")
  tokenContract       String
  fromWallet          String
  toWallet            String
  amount              Float?
  status              String    @default("DRAFT")
  requiredClaimTopics String[]  @default([]) @map("required_claim_topics")
  kycProvider         String?
  amlProvider         String?
  issuerWallet        String?
  preflightFailure    String?
  simulationError     String?
  transferTxHash      String?
  transferredAt       DateTime?
  rejectionReason     String?
  rejectedAt          DateTime?
  rejectedBy          String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([tokenContract])
  @@index([fromWallet])
  @@index([toWallet])
  @@index([kycProvider])
  @@index([amlProvider])
  @@index([issuerWallet])
  @@index([status])
}

model TokenSellListing {
  id              String    @id
  assetId         String?   @map("asset_id")
  tokenContract   String
  sellerWallet    String
  amountBaseUnits String
  amountRemaining String
  price           Float?
  currency        String?
  status          String    @default("LISTED")
  settlementTerms String?
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([assetId])
  @@index([tokenContract])
  @@index([sellerWallet])
  @@index([status])
  @@index([expiresAt])
}

model TokenBuyIntent {
  id                  String    @id
  listingId           String
  assetId             String?   @map("asset_id")
  tokenContract       String
  sellerWallet        String
  buyerWallet         String
  amountBaseUnits     String
  status              String    @default("BUYER_INTERESTED")
  requiredClaimTopics String[]  @default([]) @map("required_claim_topics")
  kycProvider         String?
  amlProvider         String?
  issuerWallet        String?
  preflightFailure    String?
  simulationError     String?
  transferTxHash      String?
  transferredAt       DateTime?
  rejectionReason     String?
  rejectedAt          DateTime?
  rejectedBy          String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([listingId])
  @@index([assetId])
  @@index([tokenContract])
  @@index([sellerWallet])
  @@index([buyerWallet])
  @@index([kycProvider])
  @@index([amlProvider])
  @@index([issuerWallet])
  @@index([status])
}

model TokenTransferHistory {
  id              String   @id
  listingId       String?
  buyIntentId     String?
  tokenContract   String
  fromWallet      String
  toWallet        String
  amountBaseUnits String
  txHash          String
  status          String   @default("TRANSFERRED")
  createdAt       DateTime @default(now())

  @@index([listingId])
  @@index([buyIntentId])
  @@index([tokenContract])
  @@index([fromWallet])
  @@index([toWallet])
  @@index([txHash])
}

